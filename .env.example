# Server Configuration
PORT=3000
FRONTEND_URL=http://localhost:5173

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/superapp

# AI Configuration - Groq (Extractor)
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
EXTRACTOR_MODEL=llama-3.3-70b-versatile

# AI Configuration - Google Gemini (Scheduler)
GEMINI_API_KEY=your_gemini_api_key_here
SCHEDULER_MODEL=gemini-1.5-flash
