PORT=3000
NODE_ENV=development

# Base URL (for Better Auth)
BASE_URL=http://localhost:3000

# Better Auth Secret (MUST change in production!)
BETTER_AUTH_SECRET=your-super-secret-key-here

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=super_app
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/super_app

# Frontend (for CORS)
FRONTEND_URL=http://localhost:5173

# Moodle Integration
MOODLE_BASE_URL=https://nalanda.bits-pilani.ac.in

# StudyDeck Integration (for course sections & schedules)
STUDYDECK_JWT_TOKEN=your_studydeck_jwt_token_here

# Gmail OAuth (for email sync)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3000/auth/gmail/callback

ENCRYPTION_KEY=your_secure_random_key_here_minimum_32_chars

# AI Integration (Required for /api/ai-integration endpoints)
# Get Groq API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Google Cloud Vertex AI (uses $300 free credits)
# 1. Create project at https://console.cloud.google.com
# 2. Enable Vertex AI API
# 3. Set up authentication (one of):
#    - Application Default Credentials: gcloud auth application-default login
#    - Service Account: Download JSON key and set GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1

# Optional: Model overrides (defaults shown)
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-1.5-flash-002
GEMINI_MODEL_THINKING=gemini-1.5-pro-002

# Debug mode (logs external API requests to debug/ folder)
DEBUG_MODE=false
