# Server Configuration
PORT=3000
FRONTEND_URL=http://localhost:5173

# Moodle Integration
MOODLE_BASE_URL=https://nalanda.bits-pilani.ac.in

# Gmail OAuth (1-click login)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# GMAIL_REDIRECT_URI is optional - auto-derived from BASE_URL (defaults to BASE_URL/auth/callback)

ENCRYPTION_KEY=your_secure_random_key_here_minimum_32_chars

# AI Integration (Required for /api/ai-integration endpoints)
# Google Cloud Vertex AI (uses $300 free credits)
# 1. Create project at https://console.cloud.google.com
# 2. Enable Vertex AI API
# 3. Set up authentication (one of):
#    - Application Default Credentials: gcloud auth application-default login
#    - Service Account: Download JSON key and set GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=keys.json

# Gemini Models (hardcoded in agent-loop.ts):
# - gemini-3-flash-preview-lite: Fast queries, simple lookups, email analysis (default)
# - gemini-3-flash-preview: Complex reasoning, planning, multi-step tasks
#
# Gmail Sync also uses gemini-3-flash-preview-lite for extracting assignments/events from emails
#
# ⚠️ DO NOT CHANGE MODELS WITHOUT USER PERMISSION

# Debug mode (logs external API requests to debug/ folder)
DEBUG_MODE=false
