{
  "name": "super-app-api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun --hot start-servers.ts",
    "dev:main": "bun --hot src/app.ts",
    "dev:streaming": "bun --hot test-isolated-server.ts",
    "start": "bun start-servers.ts",
    "start:main": "bun src/app.ts",
    "build": "bun build src/app.ts --outfile=dist/app.js --target=bun",
    "start:dist": "bun dist/app.js",
    "db:generate": "drizzle-kit generate:pg",
    "db:migrate": "bun scripts/migrate.ts",
    "db:migrate:manual": "bun scripts/run-migration.ts",
    "db:fix:class-timezone": "bun scripts/fix-class-timezone.ts --dry-run",
    "db:fix:class-timezone:apply": "bun scripts/fix-class-timezone.ts --apply",
    "db:up": "drizzle-kit up:pg",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push:pg",
    "seed:courses": "bun scripts/seed-courses.ts",
    "fix:course-matching": "bun scripts/fix-course-matching.ts",
    "test": "bun run test-api.ts",
    "test:gmail-auth": "bun test src/modules/gmail-auth/gmail-auth.service.test.ts --preload ./src/modules/gmail-auth/test-setup.ts && bun test src/modules/gmail-auth/gmail-auth.routes.test.ts --preload ./src/modules/gmail-auth/test-setup.ts",
    "test:watch": "bun --hot test-api.ts"
  },
  "dependencies": {
    "@google-cloud/vertexai": "^1.10.0",
    "@google/genai": "^1.41.0",
    "@hono/zod-validator": "^0.2.0",
    "better-auth": "^1.4.18",
    "compression": "^1.8.1",
    "drizzle-orm": "^0.30.0",
    "extend": "^3.0.2",
    "googleapis": "^171.4.0",
    "hono": "^4.11.8",
    "postgres": "^3.4.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "brace-expansion": "^4.0.1",
    "drizzle-kit": "^0.20.0"
  }
}
